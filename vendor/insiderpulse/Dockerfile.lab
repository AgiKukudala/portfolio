FROM python:3.13-slim
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY insiderpulse ./insiderpulse
COPY main.py ./
ENV LAB_HOST=0.0.0.0 INSIDERPULSE_LAB_DATA=/data
CMD ["python", "-m", "insiderpulse.lab_api"]
HEALTHCHECK --interval=30s --timeout=3s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8011/health',timeout=2)" || exit 1
